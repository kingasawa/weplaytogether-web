{
  // Cloudflare Workers configuration for weplaytogether-web
  // Deploy: npm run deploy
  // Preview local: npm run preview

  "name": "weplaytogether-web",
  "main": ".open-next/worker.js",
  "account_id": "94696f5bec8eb48c3487e8b683beff46",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets served by Cloudflare
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Custom domain routing
  "routes": [
    { "pattern": "weplaytogether.online/*", "zone_name": "weplaytogether.online" },
    { "pattern": "www.weplaytogether.online/*", "zone_name": "weplaytogether.online" }
  ],

  // Runtime env vars
